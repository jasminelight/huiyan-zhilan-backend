<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.huiyan.mapper.MonitorPointMapper">
    <resultMap id="BaseResultMap" type="com.huiyan.entity.MonitorPoint">
        <id column="id" property="id"/>
        <result column="area_name" property="areaName"/>
        <result column="point_name" property="pointName"/>
        <result column="device_no" property="deviceNo"/>
        <result column="status" property="status"/>
        <result column="longitude" property="longitude"/>
        <result column="latitude" property="latitude"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        select * from monitor_point
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        select * from monitor_point where id = #{id}
    </select>

    <insert id="insert">
        insert into monitor_point(area_name,point_name,device_no,status,longitude,latitude,create_time)
        values(#{areaName},#{pointName},#{deviceNo},#{status},#{longitude},#{latitude},#{createTime})
    </insert>

    <update id="update">
        update monitor_point set
        area_name=#{areaName},
        point_name=#{pointName},
        device_no=#{deviceNo},
        status=#{status},
        longitude=#{longitude},
        latitude=#{latitude},
        create_time=#{createTime}
        where id=#{id}
    </update>

    <delete id="deleteById">
        delete from monitor_point where id=#{id}
    </delete>

    <select id="selectRainByPointId" resultType="com.huiyan.vo.PointRainVO">
        SELECT mp.*, rd.id rain_id, rd.rain_amount, rd.record_time
        FROM monitor_point mp
        LEFT JOIN rain_data rd ON mp.id = rd.point_id
        WHERE mp.id = #{pointId}
    </select>
</mapper>